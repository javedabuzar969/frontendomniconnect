# Meta App Credentials
VITE_META_APP_ID=
META_APP_SECRET=

# Meta Webhook Verify Token
VITE_META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# WhatsApp API Version
VITE_WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_VERSION=v21.0

# Embedded Signup Configuration ID
VITE_META_CONFIG_ID=

# Backend API & Database
VITE_API_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_saas?schema=public
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production
TOKEN_ENCRYPTION_KEY=32_character_hex_encryption_key_here

# S3 Media Storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Development / Mock Mode
VITE_MOCK_WHATSAPP=true
MOCK_WHATSAPP=true
